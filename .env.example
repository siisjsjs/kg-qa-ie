# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=CHANGE_ME
APP_CONFIG_ENCRYPTION_KEY=CHANGE_ME

# ===== MySQL =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=kgqa
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=kg_qa_ie
DATABASE_URL=mysql+pymysql://kgqa:CHANGE_ME@mysql:3306/kg_qa_ie?charset=utf8mb4

# ===== Neo4j =====
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ===== Chroma =====
CHROMA_HOST=chroma
CHROMA_PORT=8001

# ===== Wiki 数据目录 =====
WIKI_ROOT=/app/data/wiki
CHROMA_PERSIST_DIR=/app/data/chroma
CACHE_DIR=/app/data/cache

# ===== LLM 默认 provider（DB 配置优先，此处仅兜底）=====
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ===== Embedding 默认 provider =====
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== JWT =====
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost
